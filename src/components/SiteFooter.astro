---
// DAY-166 / DAY-207. Minimal footer. A product-focused open-source
// project does not need a shop / careers / investor-relations stack
// here.
import { MAC_APP_STORE_URL, WINDOWS_SETUP_PATH } from "~/data/downloads";

const year = new Date().getFullYear();
---

<footer class="border-t border-white/5 bg-charcoal-900 py-10 text-sm text-zinc-500">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-6 sm:flex-row">
    <p>
      © {year} Dayseam. MIT licensed
    </p>
    <ul class="flex items-center gap-6">
      <li>
        <a
          href={MAC_APP_STORE_URL}
          class="hover:text-zinc-200 focus-visible:text-zinc-200"
          target="_blank"
          rel="noopener noreferrer"
          >Mac App Store</a
        >
      </li>
      <li>
        <a
          href={WINDOWS_SETUP_PATH}
          class="hover:text-zinc-200 focus-visible:text-zinc-200"
          download
          >Windows download</a
        >
      </li>
      <li>
        <a href="/privacy" class="hover:text-zinc-200 focus-visible:text-zinc-200">Privacy policy</a>
      </li>
      <li>
        <a
          href="#cookie-preferences"
          class="hover:text-zinc-200 focus-visible:text-zinc-200"
          >Cookie preferences</a
        >
      </li>
    </ul>
  </div>
</footer>
