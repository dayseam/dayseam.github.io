---
// DAY-166. Top-of-page navigation.
//
// Three in-page anchors plus a GitHub outbound. We resist the
// temptation to ship a full in-site nav (Product / Pricing / Blog
// / Docs) on day one because there are no separate pages yet and
// a nav with a few in-page anchors reads as confident and focused
// rather than empty.
//
// In-page anchors use `/#…` so they resolve from any route (e.g.
// `/privacy` → home sections). `/privacy` is the App Store–friendly
// public policy page.
//
// DAY-173 removed the top-right download CTA. The page already has a
// dedicated DownloadCTA section at the bottom with platform-specific
// install surfaces (Mac App Store + Windows installer), so a duplicate
// nav button would compete with the hero animation immediately below.
//
// The Mac-App-Store cutover additionally removed the outbound
// "GitHub" link from the right end of the nav: the product source
// repo is no longer public, so a "GitHub" entry would 404 for the
// public visitor it was for.
import BrandMark from "./BrandMark.astro";
---

<header class="sticky top-0 z-40 border-b border-white/5 bg-charcoal-900/80 backdrop-blur supports-[backdrop-filter]:bg-charcoal-900/60">
  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-6 py-3" aria-label="Primary">
    <a href="/" class="flex items-center gap-3" aria-label="Dayseam home">
      <BrandMark size={32} />
      <span class="font-semibold tracking-tight text-zinc-100">Dayseam</span>
    </a>

    <ul
      class="flex max-w-[min(100%,22rem)] flex-wrap items-center justify-end gap-x-5 gap-y-2 text-sm text-zinc-400 sm:max-w-none md:gap-x-7"
    >
      <li>
        <a href="/#how-it-works" class="transition-colors hover:text-zinc-100 focus-visible:text-zinc-100"
          >How it works</a
        >
      </li>
      <li>
        <a href="/#connectors" class="transition-colors hover:text-zinc-100 focus-visible:text-zinc-100">Connectors</a>
      </li>
      <li>
        <a href="/#trust" class="transition-colors hover:text-zinc-100 focus-visible:text-zinc-100">Trust</a>
      </li>
      <li>
        <a href="/privacy" class="transition-colors hover:text-zinc-100 focus-visible:text-zinc-100">Privacy policy</a>
      </li>
    </ul>
  </nav>
</header>
